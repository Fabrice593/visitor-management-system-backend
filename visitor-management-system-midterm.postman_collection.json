      "item": [
        {
          "name": "A2 - Create visit purpose",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/visit-purposes/save",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meeting {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "const today = new Date();",
                  "pm.collectionVariables.set(\"visitDate\", today.getFullYear() + \"-\" + String(today.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(today.getDate()).padStart(2, \"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Exact message\", function () { pm.expect(pm.response.text()).to.eql(\"Visit purpose saved successfully\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - List visit-purposes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/visit-purposes/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const record = pm.response.json().find(row => row.name === \"Meeting \" + pm.collectionVariables.get(\"runId\"));",
                  "pm.test(\"Created record is listed\", function () { pm.expect(record).to.be.an(\"object\"); });",
                  "if (record) pm.collectionVariables.set(\"visitPurposeId\", record.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - Get visit purpose",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/visit-purposes/{{visitPurposeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Generated UUID\", function () { pm.expect(pm.response.json().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i); });",
                  "pm.test(\"No host employee back reference\", function () { pm.expect(pm.response.json()).not.to.have.property(\"hostEmployees\"); });"
                ]
              }
            }
          ]
        },
